---
import { getCollection } from "astro:content";
import { localePath, type Locale } from "../lib/i18n";
import Layout from "../layouts/Layout.astro";

import CatalogCard from "../components/CatalogCard.astro";
import CardGrid from "../components/HomeCardGrid.astro";
import * as m from "../paraglide/messages";

import { getToolsByKind } from "../lib/catalog";
import { toolCard } from "../lib/display";
const locale = Astro.params.locale as Locale;

const APP_NAME = "CorpusHub";

const [beforeWelcome, afterWelcome] = m
  .welcome({ name: "{name}" }, { locale })
  .split("{name}");

const concordancers = await getToolsByKind("concordancer");
const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

const languageBadge = (articleLocale: string) =>
  articleLocale === locale
    ? undefined
    : new Intl.DisplayNames([locale], { type: "language" }).of(articleLocale);
---

<Layout locale={locale} title={`${beforeWelcome}${APP_NAME}${afterWelcome}`} top>
  <main class="py-10">
    <h1 class="m-4">
      {beforeWelcome}<span class="text-gradient">{APP_NAME}</span>{afterWelcome}
    </h1>
    <p class="text-center m-4 mb-10
      text-2xl">{m.slogan({}, { locale })}</p>

    <section
      class="bg-linear-to-r dark:from-accent-dark/60 dark:to-accent-dark/30 from-accent-light/60 to-accent-light/30 p-4 rounded-lg relative mb-10 py-10"
    >
      <h2 class="text-center text-3xl font-bold my-5">{m.featured({}, { locale })}</h2>
      <ul class="flex flex-col space-y-4 mt-10">
        {
          articles.map((article) => (
            <li class="text-center">
              <a
                href={localePath(article.data.locale, `articles/${article.id}`)}
                class="text-center text-2xl font-bold text-gradient"
              >
                {article.data.title}
              </a>
              {languageBadge(article.data.locale) && (
                <span class="ml-2 text-sm align-middle rounded-full px-2 py-0.5 bg-accent-light/50 dark:bg-accent-dark/50">
                  {languageBadge(article.data.locale)}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <output>
      {
        concordancers.map((tool) => <CatalogCard {...toolCard(tool, locale)} />)
      }
    </output>

    <p class="instructions my-10" set:html={m.description({}, { locale })} />

    <CardGrid locale={locale} />
  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  main {
    margin: auto;
    width: 800px;
    max-width: calc(100% - 2rem);
    @apply text-[#020305] dark:text-white transition-colors;
    font-size: 20px;
    line-height: 1.6;
  }
  .astro-a {
    position: absolute;
    top: -32px;
    left: 50%;
    transform: translatex(-50%);
    width: 220px;
    height: auto;
    z-index: -1;
  }
  h1 {
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    margin-bottom: 1em;
  }
  .instructions {
    margin-bottom: 2rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-light) 25%, transparent);
    @apply bg-linear-to-r dark:from-accent-dark/60 dark:to-accent-dark/30 from-accent-light/60 to-accent-light/30;
    padding: 1.5rem;
    border-radius: 8px;
  }
  .instructions :global(code) {
    font-size: 0.8em;
    font-weight: bold;
    @apply dark:bg-accent-light/10 dark:text-accent-light bg-accent-dark/10 text-accent-dark;
    border-radius: 4px;
    padding: 0.3em 0.4em;
  }
  .instructions :global(strong) {
    @apply dark:text-accent-light text-accent-dark;
  }

  output {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    grid-template-rows: 1fr auto;
  }
</style>
