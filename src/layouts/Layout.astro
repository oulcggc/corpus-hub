---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LOCALES, type Locale } from "../lib/i18n";

interface Props {
  title: string;
  locale: Locale;
  description?: string;
  top?: boolean;
}

const { title: rawTitle, locale, description, top } = Astro.props;
const title = top ? rawTitle : `${rawTitle} | CorpusHub`;

const pathSuffix = Astro.url.pathname.replace(/^\/[a-z]{2}(\/|$)/, "");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    {description && <meta name="description" content={description} />}
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#883aea" />
    <meta name="generator" content={Astro.generator} />
    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(`/${l}/${pathSuffix}`, Astro.site)}
        />
      ))
    }
    <title>{title}</title>
    <script is:inline>
      if (
        localStorage.getItem("color-theme") === "dark" ||
        (!localStorage.getItem("color-theme") &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} />
    <div class="flex-1">
      <slot />
    </div>
    <Footer locale={locale} />
  </body>
</html>
