---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import type { CollectionEntry } from "astro:content";
import * as m from "../paraglide/messages";
interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const frontmatter = article.data;
const { locale } = frontmatter;

const title = `${frontmatter.title} | CorpusHub`;

const dateFormat = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#883aea" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      if (
        localStorage.getItem("color-theme") === "dark" ||
        (!localStorage.getItem("color-theme") &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} />
    <main class="flex-1">
      <section id="hero">
        <hr class="border-t-2 border-gray-200 dark:border-gray-800 my-10" />
        <p class="text-center text-2xl text-gray-500 dark:text-gray-400">
          特集
        </p>
        <h1>{frontmatter.title}</h1>

        <div class="flex justify-center gap-4 my-8 flex-wrap">
          {
            frontmatter.authors.map((author) =>
              author.link ? (
                <a class="underline" href={author.link}>
                  {author.name}
                </a>
              ) : (
                <span>{author.name}</span>
              ),
            )
          }
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-center text-sm">
          {m.published({}, { locale })}:{" "}
          <time datetime={frontmatter.published.toISOString()}>
            {dateFormat.format(frontmatter.published)}
          </time>{" "}
          {
            frontmatter.updated && (
              <>
                &nbsp;&nbsp;{m.updated({}, { locale })}:{" "}
                <time datetime={frontmatter.updated.toISOString()}>
                  {dateFormat.format(frontmatter.updated)}
                </time>
              </>
            )
          }
        </p>
        <hr class="border-t-2 border-gray-200 dark:border-gray-800 my-10" />
      </section>

      <section id="content" class="leading-8 indent-4 relative">
        <output id="markdown">
          <slot />
        </output>
      </section>
    </main>
    <Footer locale={locale} />
  </body>

  <style is:global>
    @reference "../styles/global.css";

    @layer base {
      main {
        @apply text-[#020305] dark:text-white w-full max-w-2xl mx-auto p-4 py-10 transition-colors leading-10;
      }

      h1 {
        @apply m-4 my-10 text-2xl font-bold text-center;
      }

      h2 {
        @apply my-8 text-xl font-bold text-gray-700 dark:text-gray-300 indent-0;
      }

      h3 {
        @apply my-6 text-lg font-bold text-gray-600 dark:text-gray-400 indent-0;
      }

      h4 {
        @apply my-4 text-base font-bold text-gray-500 dark:text-gray-500 indent-0;
      }

      a {
        @apply hover:underline;
      }

      ul {
        @apply list-disc list-outside;
      }
    }
  </style>
</html>
