---
import ResourceItem from "@components/article/ResourceItem.astro";
import type { Locale } from "@lib/i18n";

type ResourceReference = string | {
  id: string;
  collection?: "resources" | "tools";
  description?: string | null;
  creator?: string;
};

interface Props {
  entries: ResourceReference[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
---

<ul class="not-prose list-none m-0 my-4 p-0 flex flex-col gap-3">
  {entries.map((entry) => (
    <ResourceItem {...typeof entry === "string" ? { id: entry } : entry} locale={locale} />
  ))}
</ul>
