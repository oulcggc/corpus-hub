---
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import {
  localePath,
  nativeForm,
  pickLocalized,
  type Locale,
} from "@lib/i18n";
import { categoryOf } from "@lib/display";

interface Props {
  id: string;
  collection?: "resources" | "tools";
  locale: Locale;
}

const { id, collection = "resources", locale } = Astro.props;

const entry = await getEntry(collection, id);
if (!entry) throw new Error(`Unknown ${collection} entry in article: ${id}`);

const nativeLang = entry.data.langs[0];
const name = pickLocalized(entry.data.name, locale, nativeLang);
const native = nativeForm(entry.data.name, name, nativeLang);
const description = entry.data.description
  ? (entry.data.description[locale] ?? entry.data.description["ja"])
  : undefined;
const descriptionLang = entry.data.description
  ? entry.data.description[locale]
    ? locale
    : "ja"
  : undefined;
const detailHref = localePath(locale, `${categoryOf(entry.data.kind)}/${entry.id}`);
---

<li class="resource-item">
  <p class="m-0 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <span>
      <a href={detailHref} class="font-bold">{name}</a>
      {native && <span class="text-gray-500 dark:text-gray-400">（{native}）</span>}
    </span>
    <a
      href={entry.data.link}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-baseline gap-1.5 whitespace-nowrap text-sm"
    >
      <Icon name="hugeicons:link-square-02" class="size-4 shrink-0 self-center" aria-hidden="true" />
      <span>{new URL(entry.data.link).hostname}</span>
    </a>
  </p>
  {
    entry.data.creator && (
      <p class="resource-creator m-0 mt-1 font-serif text-sm text-gray-600 dark:text-gray-400">
        {entry.data.creator}
      </p>
    )
  }
  {
    description && (
      <p class="m-0 mt-1 text-[0.95em] text-gray-600 dark:text-gray-400" lang={descriptionLang}>
        {description}
      </p>
    )
  }
</li>
