---
import { getEntry } from "astro:content";
import { externalAction } from "../../lib/service";
import { isLocale } from "../../lib/i18n";
import * as m from "../../paraglide/messages";
import ResourceRelations from "../ResourceRelations.astro";

interface Props {
  id: string;
  collection?: "resources" | "tools";
}

const { id, collection = "resources" } = Astro.props;
const entry = await getEntry(collection, id);
if (!entry) throw new Error(`Unknown ${collection} entry in article: ${id}`);
const action = externalAction(entry.data);
const locale = Astro.params.locale;
if (!locale || !isLocale(locale)) throw new Error("ResourceLink requires an article locale");
---

{entry.data.service && <strong>{m.serviceClosed({}, { locale })}{" "}</strong>}
{action && <a href={action.href}>{action.kind === "archive" ? m.viewArchive({}, { locale }) : action.href}</a>}
{"relatedResources" in entry.data && <ResourceRelations inline relations={entry.data.relatedResources} locale={locale} />}
