---
import Card from "../ConcordancerCard.astro";

const { id, locale } = Astro.props;

import { getConcordancer } from "../../data";
const concordancer = await getConcordancer(id);
---

{
  concordancer ? (
    <Card concordancer={concordancer} locale={locale} />
  ) : (
    <div>Unknown concordancer: {id}</div>
  )
}

<style>
  @reference "../../styles/global.css";

  div {
    @apply p-4 text-red-500 shadow-xs border-r-4 border-gray-200;
  }
</style>
