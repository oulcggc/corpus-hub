---
import { LOCALES, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const options = LOCALES.map((l) => ({
  value: l,
  label: new Intl.DisplayNames([l], { type: "language" }).of(l) ?? l,
}));
---

<select
  id="language-picker"
  aria-label="Language"
  class="bg-transparent border border-gray-300 dark:border-gray-700 rounded px-2 py-1"
>
  {
    options.map(({ value, label }) => (
      <option value={value} selected={value === locale}>
        {label}
      </option>
    ))
  }
</select>

<script is:inline>
  document.getElementById("language-picker").addEventListener("change", (e) => {
    const suffix = location.pathname.replace(/^\/[a-z]{2}(\/|$)/, "");
    location.href = `/${e.target.value}/${suffix}`;
  });
</script>
