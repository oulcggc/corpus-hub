---
import { Icon } from "astro-icon/components";
import { LOCALES, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const options = LOCALES.map((l) => ({
  value: l,
  label: new Intl.DisplayNames([l], { type: "language" }).of(l) ?? l,
}));
---

<div class="flex items-center justify-center gap-2">
  <Icon name="hugeicons:language-skill" class="w-6 h-6" />
  <select
    id="language-picker"
    aria-label="Language"
    class="block w-full px-3 py-2 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 border border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm min-w-24"
  >
    {
      options.map(({ value, label }) => (
        <option value={value} selected={value === locale}>
          {label}
        </option>
      ))
    }
  </select>
</div>

<script is:inline>
  document.getElementById("language-picker").addEventListener("change", (e) => {
    const suffix = location.pathname.replace(/^\/[a-z]{2}(\/|$)/, "");
    location.href = `/${e.target.value}/${suffix}`;
  });
</script>
