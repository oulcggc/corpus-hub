---
import * as m from "../paraglide/messages";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  title: string;
  titleNative?: string | undefined;
  detailHref: string;
  externalHref: string;
  org?: { name: string; href: string } | undefined;
  items?: { label: string; href: string }[];
  chips?: string[];
}

const {
  locale,
  title,
  titleNative,
  detailHref,
  externalHref,
  org,
  items = [],
  chips = [],
} = Astro.props;
---

<div class="catalog-card">
  <div class="catalog-card-inner">
    <div class="catalog-head">
      <div class="catalog-identity">
        <a class="title" href={detailHref}>{title}</a>
        {
          titleNative && (
            <span class="native">{titleNative}</span>
          )
        }
        {
          org && (
            <a class="provider" href={org.href}>
              {org.name}
            </a>
          )
        }
      </div>
      {
        chips.length > 0 && (
          <ul class="chips">
            {chips.map((chip) => (
              <li class="chip">{chip}</li>
            ))}
          </ul>
        )
      }
    </div>

    {
      items.length > 0 && (
        <ul class="served">
          {items.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="actions">
      <a class="btn btn-ghost" href={detailHref}>
        {m.viewDetails({}, { locale })}
      </a>
      <a
        class="btn btn-primary"
        href={externalHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        {m.visitSite({}, { locale })}
      </a>
    </div>
  </div>
</div>

<style>
  .catalog-card {
    display: flex;
    height: 100%;
    padding: 1px;
    background-color: var(--color-gray-100);
    background-image: none;
    background-size: 400%;
    background-position: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--rim-inset);
    transition: background-position 0.6s var(--ease-sweep);
  }
  :global(.dark) .catalog-card {
    background-color: var(--color-gray-800);
  }
  .catalog-card-inner {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
    padding: 1.1rem 1.15rem 1rem;
    border-radius: calc(var(--radius-lg) - 1px);
    color: var(--color-gray-900);
    background-color: var(--color-gray-200);
    line-height: 1.7;
  }
  :global(.dark) .catalog-card-inner {
    color: var(--color-gray-100);
    background-color: var(--color-gray-800);
  }
  .catalog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .catalog-identity {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
    gap: 0.15rem;
  }
  .title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.45;
    text-decoration: none;
    color: inherit;
    transition: color 0.6s var(--ease-sweep);
  }
  .native {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-gray-500);
  }
  :global(.dark) .native {
    color: var(--color-gray-400);
  }
  .provider {
    font-size: 0.8125rem;
    line-height: 1.6;
    text-decoration: none;
    color: var(--color-gray-500);
  }
  :global(.dark) .provider {
    color: var(--color-gray-400);
  }
  .provider:hover,
  .provider:focus-visible {
    color: var(--color-accent-dark);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  :global(.dark) .provider:hover,
  :global(.dark) .provider:focus-visible {
    color: var(--color-accent-light);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.3rem;
    max-width: 46%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .served {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
    padding: 0.15rem 0 0.15rem 0.75rem;
    list-style: none;
    border-left: 2px solid color-mix(in srgb, var(--color-accent) 38%, transparent);
    font-size: 0.875rem;
    line-height: 1.65;
  }
  .served a {
    color: inherit;
    text-decoration: none;
  }
  .served a:hover,
  .served a:focus-visible {
    color: var(--color-accent-dark);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  :global(.dark) .served a:hover,
  :global(.dark) .served a:focus-visible {
    color: var(--color-accent-light);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }
  .actions .btn {
    flex: 1 1 8.25rem;
  }
  .catalog-card:is(:hover, :focus-within) {
    background-position: 0;
    background-image: var(--accent-gradient);
  }
  .catalog-card:is(:hover, :focus-within) .title {
    color: var(--color-accent-dark);
  }
  :global(.dark) .catalog-card:is(:hover, :focus-within) .title {
    color: var(--color-accent-light);
  }
</style>
