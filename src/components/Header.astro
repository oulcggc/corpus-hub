---
import { Icon } from "astro-icon/components";
import * as m from "../paraglide/messages";
import { localePath, type Locale } from "../lib/i18n";
import LanguagePicker from "./LanguagePicker.astro";
import ThemeSwitch from "./ThemeSwitch.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const links = [
  { path: localePath(locale, "corpora"), name: m.corpora({}, { locale }) },
  {
    path: localePath(locale, "concordancers"),
    name: m.concordancers({}, { locale }),
  },
  {
    path: localePath(locale, "dictionaries"),
    name: m.dictionaries({}, { locale }),
  },
  { path: localePath(locale, "datasets"), name: m.datasets({}, { locale }) },
  { path: localePath(locale, "archives"), name: m.archives({}, { locale }) },
  { path: localePath(locale, "tools"), name: m.tools({}, { locale }) },
];
---

<header
  class="flex flex-col items-center gap-3 px-6 py-4 text-ink dark:text-white md:flex-row md:gap-5 border-b border-black/5 dark:border-white/8"
>
  <div class="flex w-full items-center justify-between md:w-auto">
    <a
      href={localePath(locale)}
      class="text-xl font-black tracking-tight text-current"
      >CorpusHub</a
    >
    <button
      type="button"
      aria-label="Menu"
      aria-controls="navbar-menu"
      aria-expanded="false"
      class="group rounded-md p-2 md:hidden hover:bg-accent-light/40 dark:hover:bg-accent-dark/40"
      id="navigation-toggle"
    >
      <Icon
        name="hugeicons:menu-01"
        class="w-6 h-6 group-aria-expanded:hidden"
        aria-hidden="true"
      />
      <Icon
        name="hugeicons:cancel-01"
        class="hidden w-6 h-6 group-aria-expanded:block"
        aria-hidden="true"
      />
    </button>
  </div>
  <div
    id="navbar-menu"
    class="hidden w-full flex-col gap-5 md:flex md:flex-row md:items-center md:justify-between md:gap-4"
  >
    <nav class="flex min-w-0 w-full items-center">
      <ul
        class="m-0 flex list-none flex-wrap items-center gap-1 p-0"
      >
        {
          links.map(({ path, name }) => (
            <li class="leading-none">
              <a
                href={path}
                class:list={[
                  "inline-flex items-center whitespace-nowrap rounded-md px-2.5 py-1.5 text-[0.9375rem] leading-none no-underline transition-colors",
                  Astro.url.pathname === path
                    ? "font-bold text-accent-dark bg-accent-light/55 dark:text-accent-light dark:bg-accent-dark/45"
                    : "font-medium text-ink/70 hover:bg-gray-100 hover:text-ink dark:text-white/70 dark:hover:bg-white/6 dark:hover:text-white",
                ]}
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex shrink-0 items-center justify-end gap-2">
      <ThemeSwitch />
      <LanguagePicker locale={locale} />
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById("navigation-toggle").addEventListener("click", () => {
    const menu = document.getElementById("navbar-menu");
    const toggle = document.getElementById("navigation-toggle");
    const open = menu.classList.toggle("hidden") === false;
    menu.classList.toggle("flex", open);
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
