---
import { Icon } from "astro-icon/components";
import * as m from "../paraglide/messages";
import { localePath, type Locale } from "../lib/i18n";
import LanguagePicker from "./LanguagePicker.astro";
import ThemeSwitch from "./ThemeSwitch.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const links = [
  { path: localePath(locale, "corpora"), name: m.corpora({}, { locale }) },
  {
    path: localePath(locale, "concordancers"),
    name: m.concordancers({}, { locale }),
  },
];
---

<header
  class="p-6 flex flex-col md:flex-row md:items-center gap-4 text-ink dark:text-white"
>
  <div class="flex justify-between items-center w-full md:w-auto">
    <a href={localePath(locale)} class="font-black text-current">CorpusHub</a>
    <button
      aria-label="Menu"
      aria-expanded="false"
      class="md:hidden p-2"
      id="navigation-toggle"
    >
      <Icon name="hugeicons:menu-01" class="w-6 h-6" />
    </button>
  </div>
  <div
    id="navbar-menu"
    class="hidden md:flex flex-col md:flex-row md:justify-between gap-6 md:gap-4 w-full"
  >
    <nav>
      <ul class="flex items-center gap-4 list-none m-0 p-0">
        {
          links.map(({ path, name }) => (
            <li>
              <a
                href={path}
                class:list={[
                  { "font-bold": Astro.url.pathname === path },
                  "hover:underline",
                ]}
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex gap-4 items-center justify-end">
      <ThemeSwitch />
      <LanguagePicker locale={locale} />
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById("navigation-toggle").addEventListener("click", () => {
    const menu = document.getElementById("navbar-menu");
    const toggle = document.getElementById("navigation-toggle");
    const open = menu.classList.toggle("hidden") === false;
    menu.classList.toggle("flex", open);
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
