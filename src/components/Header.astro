---
import { localePath } from "../lib/i18n";
import { languageTag } from "../paraglide/runtime";
import { Icon } from "astro-icon/components";
import LanguagePicker from "./LanguagePicker.astro";
import ThemeSwitcher from "./ThemeSwitch.astro";
import * as m from "../paraglide/messages";
---

<header
  class="p-6 align-middle flex justify-between md:justify-normal items-center text-[#020305] dark:text-white transition-colors gap-4
    md:flex-row flex-col"
>
  <div class="flex justify-between items-center w-full md:w-auto">
    <a href={localePath(languageTag())} class="font-black text-current">CorpusHub</a>
    <button
      type="button"
      aria-label="Menu"
      aria-controls="navbar-menu"
      aria-expanded="false"
      class="group md:hidden p-2"
      id="navigation-toggle"
    >
      <Icon
        name="hugeicons:menu-01"
        class="w-6 h-6 group-aria-expanded:hidden"
        aria-hidden="true"
      />
      <Icon
        name="hugeicons:cancel-01"
        class="hidden w-6 h-6 group-aria-expanded:block"
        aria-hidden="true"
      />
    </button>
  </div>
  <div
    id="navbar-menu"
    class="hidden md:flex flex-col md:flex-row justify-between gap-6 md:gap-4 w-full md:p-0 p-6"
  >
    <nav class="flex w-full items-center gap-4 flex-wrap md:flex-nowrap">
      <ul class="contents list-none m-0 p-0">
        {
          [
            {
              path: localePath(languageTag(), "concordancers"),
              name: m.concordancers(),
            },
            {
              path: localePath(languageTag(), "corpora"),
              name: m.corpora(),
            },
            {
              path: localePath(languageTag(), "datasets"),
              name: m.datasets(),
            },
            {
              path: localePath(languageTag(), "dictionaries"),
              name: m.dictionaries(),
            },
          ].map(({ path, name }) => (
            <li>
              <a
                href={path}
                class:list={[
                  {
                    active: path === Astro.url.pathname,
                  },
                  "hover:underline",
                ]}
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex gap-4 items-center justify-end flex-wrap md:flex-nowrap">
      <ThemeSwitcher />
      <LanguagePicker />
    </div>
  </div>

  <script is:inline>
    document
      .getElementById("navigation-toggle")
      .addEventListener("click", () => {
        const menu = document.getElementById("navbar-menu");
        const toggle = document.getElementById("navigation-toggle");
        const open = menu.classList.toggle("hidden") === false;
        menu.classList.toggle("flex", open);
        toggle.setAttribute("aria-expanded", String(open));
      });
  </script>
</header>

<style>
  nav ul li a.active {
    font-weight: bold;
  }
</style>
