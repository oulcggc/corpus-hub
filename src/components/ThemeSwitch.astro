---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2.5"
>
  <Icon name="hugeicons:moon-02" class="w-5 h-5 dark:hidden" />
  <Icon name="hugeicons:sun-03" class="w-5 h-5 hidden dark:block text-yellow-300" />
</button>

<script is:inline>
  document.getElementById("theme-toggle").addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("color-theme", dark ? "dark" : "light");
  });
</script>
