---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class="rounded-md p-2.5 text-gray-500 hover:bg-accent-light/45 hover:text-accent-dark dark:text-gray-400 dark:hover:bg-accent-dark/45 dark:hover:text-accent-light"
>
  <Icon name="hugeicons:moon-02" class="w-5 h-5 dark:hidden" />
  <Icon name="hugeicons:sun-03" class="w-5 h-5 hidden dark:block text-yellow-300" />
</button>

<script is:inline>
  document.getElementById("theme-toggle").addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("color-theme", dark ? "dark" : "light");
  });
</script>
