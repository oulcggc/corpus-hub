---
interface Props {
  title: string;
  body: string;
  href: string;
}

const { href, title, body } = Astro.props;
---

<li class="link-card">
  <a href={href}>
    <h2>
      {title}
      <span>&rarr;</span>
    </h2>
    <p>
      {body}
    </p>
  </a>
</li>

<style>
  .link-card {
    list-style: none;
    display: flex;
    padding: 1px;
    background-color: var(--color-gray-100);
    background-image: none;
    background-size: 400%;
    border-radius: var(--radius-lg);
    background-position: 100%;
    transition: background-position 0.6s var(--ease-sweep);
    box-shadow: var(--rim-inset);
  }
  :global(.dark) .link-card {
    background-color: var(--color-gray-800);
  }
  .link-card > a {
    width: 100%;
    text-decoration: none;
    line-height: 1.7;
    padding: calc(1.5rem - 1px);
    border-radius: calc(var(--radius-lg) - 1px);
    color: var(--color-gray-900);
    background-color: var(--color-gray-200);
    opacity: 0.9;
  }
  :global(.dark) .link-card > a {
    color: var(--color-gray-100);
    background-color: var(--color-gray-800);
  }
  h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    transition: color 0.6s var(--ease-sweep);
  }
  p {
    margin-top: 0.5rem;
    margin-bottom: 0;
    font-size: 1rem;
  }
  .link-card:is(:hover, :focus-within) {
    background-position: 0;
    background-image: var(--accent-gradient);
  }
  .link-card:is(:hover, :focus-within) h2 {
    color: var(--color-accent-dark);
  }
  :global(.dark) .link-card:is(:hover, :focus-within) h2 {
    color: var(--color-accent-light);
  }
</style>
