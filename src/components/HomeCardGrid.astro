---
import { localePath, type Locale } from "../lib/i18n";
import Card from "./Card.astro";
import * as m from "../paraglide/messages";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ul
  role="list"
  class="grid gap-4 p-0 grid-cols-[repeat(auto-fit,minmax(24ch,1fr))]"
  aria-label="List of resources"
  class="link-card-grid"
>
  <Card
    href={localePath(locale, "concordancers")}
    title={m.concordancers({}, { locale })}
    body={m.concordancersDesc({}, { locale })}
  />
  <Card href={localePath(locale, "corpora")} title={m.corpora({}, { locale })} body={m.corporaDesc({}, { locale })} />
  <Card href={localePath(locale, "datasets")} title={m.datasets({}, { locale })} body={m.datasetsDesc({}, { locale })} />
  <Card
    href={localePath(locale, "dictionaries")}
    title={m.dictionaries({}, { locale })}
    body={m.dictionariesDesc({}, { locale })}
  />
</ul>
