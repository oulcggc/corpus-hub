---
import * as m from "../paraglide/messages";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const SUGGEST_URL = "https://github.com/oulcggc/corpus-hub/issues/new";
---

<footer
  class="flex flex-col gap-3 border-t border-black/5 bg-gray-100 px-6 py-10 text-center text-gray-800 dark:border-white/8 dark:bg-gray-950 dark:text-gray-200"
>
  <p>
    <a
      class="underline decoration-accent/40 underline-offset-4 hover:text-accent-dark dark:hover:text-accent-light"
      href={SUGGEST_URL}>{m.suggest({}, { locale })}</a
    >
  </p>
  <p>
    © 2024–2026 <a
      class="underline decoration-accent/40 underline-offset-4 hover:text-accent-dark dark:hover:text-accent-light"
      href="https://oulcggc.org/"
      target="_blank">阪大言語サークルGGC</a
    >
  </p>
  <address class="flex flex-col gap-2 text-sm not-italic text-gray-600 dark:text-gray-400">
    <p>with ❤️ by</p>
    <div class="flex flex-col justify-center gap-1.5">
      <a
        class="underline decoration-accent/40 underline-offset-4 hover:text-accent-dark dark:hover:text-accent-light"
        href="https://yocjyet.dev/"
        target="_blank"
      >
        Yo, Cjyet (于拙)
      </a>
      <a
        class="underline decoration-accent/40 underline-offset-4 hover:text-accent-dark dark:hover:text-accent-light"
        href="https://homepage-82o.pages.dev/"
        target="_blank"
      >
        YuNai
      </a>
    </div>
    <p>and more...</p>
  </address>
</footer>
