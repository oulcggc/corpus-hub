---
import * as m from "@paraglide/messages";
import type { Locale } from "@lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const SUGGEST_URL = "https://github.com/oulcggc/corpus-hub/issues/new";
---

<footer>
  <p>
    <a href={SUGGEST_URL}>{m.suggest({}, { locale })}</a>
  </p>
  <p>
    &copy; 2024–2026 <a href="https://oulcggc.org/" target="_blank"
      >阪大言語サークルGGC</a
    >
  </p>
  <address>
    <p>with ❤️ by</p>
    <div class="authors">
      <a href="https://yocjyet.dev/" target="_blank"> Yo, Cjyet (于拙) </a>
      <!-- TODO: Change to custom domain -->
      <a href="https://homepage-82o.pages.dev/" target="_blank"> YuNai </a>
    </div>
    <p>and more...</p>
  </address>
</footer>

<style>
  @reference "../styles/global.css";

  footer {
    text-align: center;
    padding: 2em 1em;
    @apply bg-gray-200 dark:bg-gray-950;
    @apply text-gray-900 dark:text-gray-50;
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  a {
    @apply text-inherit;
    text-decoration: underline;
  }

  .authors {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5em;
  }

  address {
    font-style: normal;
    font-size: 0.8em;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }
</style>
