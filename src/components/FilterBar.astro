---
import * as m from "../paraglide/messages";
import type { Locale } from "../lib/i18n";

export interface Facet {
  key: string;
  label: string;
  options: { value: string; label: string }[];
}

interface Props {
  locale: Locale;
  facets: Facet[];
}

const { locale, facets } = Astro.props;
---

<form
  id="filter-bar"
  class="flex flex-wrap gap-3 items-center mb-8"
  autocomplete="off"
>
  <input
    type="search"
    name="q"
    placeholder={m.search({}, { locale })}
    aria-label={m.search({}, { locale })}
    class="flex-1 min-w-48 bg-transparent border border-gray-300 dark:border-gray-700 rounded px-3 py-2"
  />
  {
    facets.map((facet) => (
      <select
        name={facet.key}
        aria-label={facet.label}
        class="bg-paper dark:bg-paper-dark border border-gray-300 dark:border-gray-700 rounded px-2 py-2"
      >
        <option value="">{facet.label}</option>
        {facet.options.map(({ value, label }) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    ))
  }
  <button
    type="reset"
    class="px-3 py-2 border border-gray-300 dark:border-gray-700 rounded"
  >
    {m.clear({}, { locale })}
  </button>
</form>
<p id="no-results" class="text-gray-600 dark:text-gray-400" hidden>
  {m.noResults({}, { locale })}
</p>

<script is:inline>
  (() => {
    const form = document.getElementById("filter-bar");
    const noResults = document.getElementById("no-results");

    function apply() {
      const entries = [...document.querySelectorAll("[data-entry]")];
      const data = new FormData(form);
      const q = (data.get("q") ?? "").toString().toLowerCase().trim();
      const active = [...data.entries()].filter(
        ([key, value]) => key !== "q" && value !== "",
      );
      let visible = 0;
      for (const entry of entries) {
        const matchesText =
          q === "" || entry.dataset.text.includes(q);
        const matchesFacets = active.every(([key, value]) =>
          (entry.dataset[`facet${key[0].toUpperCase()}${key.slice(1)}`] ?? "")
            .split(" ")
            .includes(value),
        );
        const show = matchesText && matchesFacets;
        entry.hidden = !show;
        if (show) visible++;
      }
      noResults.hidden = visible > 0;
      const params = new URLSearchParams();
      if (q) params.set("q", q);
      for (const [key, value] of active) params.set(key, value.toString());
      history.replaceState(
        null,
        "",
        params.size ? `?${params}` : location.pathname,
      );
    }

    form.addEventListener("input", apply);
    form.addEventListener("reset", () => setTimeout(apply));

    const params = new URLSearchParams(location.search);
    for (const [key, value] of params) {
      const field = form.elements.namedItem(key);
      if (field) field.value = value;
    }
    if ([...params].length) {
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", apply);
      } else {
        apply();
      }
    }
  })();
</script>
