---
import * as m from "../paraglide/messages";
import type { Locale } from "../lib/i18n";

export interface Facet {
  key: string;
  label: string;
  options: { value: string; label: string }[];
}

interface Props {
  locale: Locale;
  facets: Facet[];
}

const { locale, facets } = Astro.props;
---

<form
  id="filter-bar"
  class="filter-bar"
  autocomplete="off"
>
  <input
    type="search"
    name="q"
    placeholder={m.search({}, { locale })}
    aria-label={m.search({}, { locale })}
    class="filter-search"
  />
  {
    facets.map((facet) => (
      <select
        name={facet.key}
        aria-label={facet.label}
        class="filter-select"
      >
        <option value="">{facet.label}</option>
        {facet.options.map(({ value, label }) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    ))
  }
  <button type="reset" class="btn btn-ghost filter-reset">
    {m.clear({}, { locale })}
  </button>
</form>
<p id="no-results" class="no-results" hidden>
  {m.noResults({}, { locale })}
</p>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 0.5rem;
    background-color: var(--color-gray-100);
    border-radius: var(--radius-lg);
    box-shadow: var(--rim-inset);
  }
  :global(.dark) .filter-bar {
    background-color: var(--color-gray-800);
  }
  .filter-search,
  .filter-select {
    min-height: 2.5rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-md);
    background-color: var(--color-paper);
    color: inherit;
    font: inherit;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  :global(.dark) .filter-search,
  :global(.dark) .filter-select {
    border-color: var(--color-gray-700);
    background-color: var(--color-paper-dark);
  }
  .filter-search {
    flex: 1 1 12rem;
    min-width: 12rem;
  }
  .filter-select {
    flex: 0 1 auto;
    max-width: 100%;
  }
  .filter-search:focus,
  .filter-select:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 22%, transparent);
  }
  .filter-reset {
    flex: 0 0 auto;
  }
  .no-results {
    margin: 0 0 1.25rem;
    color: var(--color-gray-600);
    line-height: 1.7;
  }
  :global(.dark) .no-results {
    color: var(--color-gray-400);
  }
</style>

<script is:inline>
  (() => {
    const form = document.getElementById("filter-bar");
    const noResults = document.getElementById("no-results");

    function apply() {
      const entries = [...document.querySelectorAll("[data-entry]")];
      const data = new FormData(form);
      const q = (data.get("q") ?? "").toString().toLowerCase().trim();
      const active = [...data.entries()].filter(
        ([key, value]) => key !== "q" && value !== "",
      );
      let visible = 0;
      for (const entry of entries) {
        const matchesText =
          q === "" || entry.dataset.text.includes(q);
        const matchesFacets = active.every(([key, value]) =>
          (entry.dataset[`facet${key[0].toUpperCase()}${key.slice(1)}`] ?? "")
            .split(" ")
            .includes(value),
        );
        const show = matchesText && matchesFacets;
        entry.hidden = !show;
        if (show) visible++;
      }
      noResults.hidden = visible > 0;
      const params = new URLSearchParams();
      if (q) params.set("q", q);
      for (const [key, value] of active) params.set(key, value.toString());
      history.replaceState(
        null,
        "",
        params.size ? `?${params}` : location.pathname,
      );
    }

    form.addEventListener("input", apply);
    form.addEventListener("reset", () => setTimeout(apply));

    const params = new URLSearchParams(location.search);
    for (const [key, value] of params) {
      const field = form.elements.namedItem(key);
      if (field) field.value = value;
    }
    if ([...params].length) {
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", apply);
      } else {
        apply();
      }
    }
  })();
</script>
