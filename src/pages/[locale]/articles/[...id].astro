---
import { getCollection, render } from "astro:content";
import { groupArticleVersions } from "@lib/articles";
import Layout from "@layouts/Layout.astro";
import * as m from "@paraglide/messages";
import VisitorCounter from "@components/VisitorCounter.astro";
import FavouriteButton from "@components/article/FavouriteButton.astro";
import type { Locale } from "@lib/i18n";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const groups = groupArticleVersions(articles);
  return articles.map((article) => ({
    params: {
      locale: article.data.locale,
      id: article.data.slug,
    },
    props: { article, versions: groups.get(article.data.slug)!.map((version) => version.data.locale) },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
  versions: Locale[];
}

const locale = Astro.params.locale as Locale;
const { article, versions } = Astro.props;
const { Content, headings } = await render(article);
const contents = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

const dateFormat = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title={article.data.title}
  locale={locale}
  description={article.data.description}
  alternates={versions}
>
  <main
    class="mx-auto w-[800px] max-w-[calc(100%-2rem)] py-10 text-ink dark:text-white"
  >
    <section>
      <hr class="border-t-2 border-gray-200 dark:border-gray-800 my-10" />
      <p class="text-center text-2xl text-gray-500 dark:text-gray-400">
        {m.featured({}, { locale })}
      </p>
      <h1 class="text-3xl md:text-4xl font-bold text-center my-6">
        {article.data.title}
      </h1>
      <div class="flex justify-center gap-4 my-8 flex-wrap">
        {
          article.data.authors.map((author) => (
            <span class="inline-flex items-center gap-2">
              {author.avatar && (
                <img
                  src={author.avatar}
                  alt=""
                  width="32"
                  height="32"
                  class="w-8 h-8 rounded-full object-cover"
                />
              )}
              {author.link ? (
                <a class="underline" href={author.link}>
                  {author.name}
                </a>
              ) : (
                <span>{author.name}</span>
              )}
            </span>
          ))
        }
      </div>
      <p class="text-gray-500 dark:text-gray-400 text-center text-sm">
        {m.published({}, { locale })}:{" "}
        <time datetime={article.data.published.toISOString()}>
          {dateFormat.format(article.data.published)}
        </time>{" "}
        {
          article.data.updated && (
            <>
              &nbsp;&nbsp;{m.updated({}, { locale })}:{" "}
              <time datetime={article.data.updated.toISOString()}>
                {dateFormat.format(article.data.updated)}
              </time>
            </>
          )
        }
        &nbsp;&nbsp;<VisitorCounter locale={locale} />
      </p>
      <hr class="border-t-2 border-gray-200 dark:border-gray-800 my-10" />
    </section>

    <details
      class="xl:hidden mb-8 rounded-lg border border-gray-200 dark:border-gray-800 px-4 py-2 text-sm"
    >
      <summary class="cursor-pointer text-gray-500 dark:text-gray-400">
        {m.contents({}, { locale })}
      </summary>
      <ol class="mt-2 mb-1 space-y-1.5">
        {
          contents.map((h) => (
            <li style={`padding-left: ${(h.depth - 2) * 0.75}rem`}>
              <a class="hover:text-accent" href={`#${h.slug}`}>
                {h.text}
              </a>
            </li>
          ))
        }
      </ol>
    </details>

    <div class="relative">
      <article
        class="relative prose dark:prose-invert max-w-none prose-a:break-all"
      >
        <!-- Floating menu to the left -->
        <div
          class="not-prose absolute top-0 left-[-5rem] flex flex-col text-center items-center justify-center"
        >
          <FavouriteButton locale={locale} />
        </div>
        <Content />
      </article>
      <nav
        aria-labelledby="contents"
        class="hidden xl:block absolute top-0 bottom-0 left-full ml-8 w-48"
      >
        <div class="sticky top-8 text-sm">
          <h2
            id="contents"
            class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"
          >
            {m.contents({}, { locale })}
          </h2>
          <ol
            class="space-y-1.5 border-l border-gray-200 dark:border-gray-800 leading-snug"
          >
            {
              contents.map((h) => (
                <li style={`padding-left: ${0.75 + (h.depth - 2) * 0.75}rem`}>
                  <a
                    class="block text-gray-600 dark:text-gray-400 hover:text-accent"
                    href={`#${h.slug}`}
                  >
                    {h.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </nav>
    </div>
  </main>
</Layout>
