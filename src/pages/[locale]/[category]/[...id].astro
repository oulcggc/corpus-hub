---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import * as m from "../../../paraglide/messages";
import {
  LOCALES,
  localePath,
  pickLocalized,
  nativeForm,
  type Locale,
} from "../../../lib/i18n";
import {
  resolveResource,
  resolveTool,
  type ResolvedResource,
  type ResolvedTool,
} from "../../../lib/catalog";
import {
  accessChips,
  categoryOf,
  labelPeriod,
  labelTag,
  languageNames,
} from "../../../lib/display";

export async function getStaticPaths() {
  const resources = await Promise.all(
    (await getCollection("resources")).map(resolveResource),
  );
  const tools = await Promise.all(
    (await getCollection("tools")).map(resolveTool),
  );
  return LOCALES.flatMap((locale) => [
    ...resources.map((entry) => ({
      params: {
        locale,
        category: categoryOf(entry.data.kind),
        id: entry.id,
      },
      props: { entry, type: "resource" as const },
    })),
    ...tools.map((entry) => ({
      params: {
        locale,
        category: categoryOf(entry.data.kind),
        id: entry.id,
      },
      props: { entry, type: "tool" as const },
    })),
  ]);
}

interface Props {
  entry: ResolvedResource | ResolvedTool;
  type: "resource" | "tool";
}

const locale = Astro.params.locale as Locale;
const { entry, type } = Astro.props;

const nativeLang = entry.data.langs[0];
const name = pickLocalized(entry.data.name, locale, nativeLang);
const nameNative = nativeForm(entry.data.name, name, nativeLang);
const description = entry.data.description
  ? (entry.data.description[locale] ?? entry.data.description["ja"])
  : undefined;
const descriptionLang = entry.data.description
  ? entry.data.description[locale]
    ? locale
    : "ja"
  : undefined;
const abbr = entry.data.abbr
  ? pickLocalized(entry.data.abbr, locale, nativeLang)
  : undefined;

const orgAbbr = entry.organization
  ? (entry.organization.data.abbr ?? entry.organization.data.name)
  : undefined;
const orgName = entry.organization
  ? pickLocalized(entry.organization.data.name, locale)
  : undefined;

const related =
  type === "resource"
    ? (entry as ResolvedResource).tools.map((tool) => ({
        label: pickLocalized(tool.data.name, locale, tool.data.langs[0]),
        href: localePath(locale, `${categoryOf(tool.data.kind)}/${tool.id}`),
      }))
    : (entry as ResolvedTool).resources.map((resource) => ({
        label: pickLocalized(resource.data.name, locale, resource.data.langs[0]),
        href: localePath(
          locale,
          `${categoryOf(resource.data.kind)}/${resource.id}`,
        ),
      }));

const relatedLabel =
  type === "resource"
    ? m.searchTools({}, { locale })
    : m.searchableResources({}, { locale });

const resourceData =
  type === "resource" ? (entry as ResolvedResource).data : undefined;

const jsonLd = resourceData
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Dataset",
      name,
      alternateName: Object.values(resourceData.name).filter((v) => v !== name),
      url: resourceData.link,
      inLanguage: resourceData.langs,
      ...(entry.organization
        ? {
            creator: {
              "@type": "Organization",
              name: pickLocalized(entry.organization.data.name, "en"),
              url: entry.organization.data.link,
            },
          }
        : {}),
      ...(resourceData.license ? { license: resourceData.license } : {}),
    })
  : undefined;

const citation = resourceData?.citation;

const rows: { label: string; html?: boolean; value: string }[] = [
  {
    label: m.languages({}, { locale }),
    value: languageNames(entry.data.langs, locale).join(", "),
  },
];

if (type === "resource") {
  const resource = entry as ResolvedResource;
  if (resource.data.period)
    rows.push({
      label: m.period({}, { locale }),
      value: resource.data.period
        .map((value) => labelPeriod(value, locale))
        .join(", "),
    });
  if (resource.data.tags.length > 0)
    rows.push({
      label: m.tags({}, { locale }),
      value: resource.data.tags
        .map((value) => labelTag(value, locale))
        .join(", "),
    });
} else {
  rows.push({
    label: m.access({}, { locale }),
    value: accessChips((entry as ResolvedTool).data.access, locale).join(", "),
  });
}
---

<Layout title={abbr ?? name} locale={locale}>
  <main
    class="mx-auto w-[800px] max-w-[calc(100%-2rem)] py-12 leading-relaxed text-ink dark:text-white"
  >
    <h1 class="text-3xl font-bold leading-snug tracking-tight">{name}</h1>
    {
      nameNative && (
        <p class="mt-2 text-xl leading-relaxed text-gray-500 dark:text-gray-400">
          {nameNative}
        </p>
      )
    }
    {
      description && (
        <p
          class="mt-5 text-[1.0625rem] leading-relaxed text-gray-700 dark:text-gray-300"
          lang={descriptionLang}
        >
          {description}
        </p>
      )
    }

    <dl class="entry-meta">
      {
        entry.organization && orgAbbr && (
          <>
            <dt>{m.organization({}, { locale })}</dt>
            <dd>
              <a href={entry.organization.data.link}>
                {pickLocalized(orgAbbr, locale)}
                {orgName !== pickLocalized(orgAbbr, locale) && ` (${orgName})`}
              </a>
            </dd>
          </>
        )
      }
      {
        rows.map(({ label, value }) => (
          <>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </>
        ))
      }
      {
        related.length > 0 && (
          <>
            <dt>{relatedLabel}</dt>
            <dd>
              <ul class="related">
                {related.map(({ label, href }) => (
                  <li>
                    <a href={href}>{label}</a>
                  </li>
                ))}
              </ul>
            </dd>
          </>
        )
      }
    </dl>

    {
      citation && (
        <figure class="citation">
          <figcaption>Citation</figcaption>
          <blockquote class="select-all">{citation}</blockquote>
        </figure>
      )
    }

    <a
      class="btn btn-primary px-6"
      href={entry.data.link}
      target="_blank"
      rel="noopener noreferrer"
    >
      {m.visitSite({}, { locale })}
    </a>

    {
      jsonLd && (
        <script type="application/ld+json" set:html={jsonLd} is:inline />
      )
    }
  </main>
</Layout>

<style>
  .entry-meta {
    display: grid;
    grid-template-columns: minmax(6.75rem, 9.25rem) 1fr;
    margin: 2rem 0;
    overflow: hidden;
    background-color: var(--color-gray-100);
    border-radius: var(--radius-lg);
    box-shadow: var(--rim-inset);
  }
  :global(.dark) .entry-meta {
    background-color: var(--color-gray-800);
  }
  .entry-meta dt,
  .entry-meta dd {
    margin: 0;
    padding: 0.85rem 1.15rem;
    line-height: 1.7;
    border-bottom: 1px solid rgb(16 8 32 / 0.06);
  }
  :global(.dark) .entry-meta dt,
  :global(.dark) .entry-meta dd {
    border-bottom-color: rgb(255 255 255 / 0.08);
  }
  .entry-meta dt {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-gray-600);
  }
  :global(.dark) .entry-meta dt {
    color: var(--color-gray-400);
  }
  .entry-meta dd {
    min-width: 0;
  }
  .entry-meta dt:nth-last-of-type(1),
  .entry-meta dd:nth-last-of-type(1) {
    border-bottom: none;
  }
  .entry-meta a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-accent) 42%,
      transparent
    );
    text-underline-offset: 0.18em;
  }
  .entry-meta a:hover,
  .entry-meta a:focus-visible {
    color: var(--color-accent-dark);
  }
  :global(.dark) .entry-meta a:hover,
  :global(.dark) .entry-meta a:focus-visible {
    color: var(--color-accent-light);
  }
  .related {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related a {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    padding: 0.2rem 0;
    line-height: 1.65;
  }
  .citation {
    margin: 2rem 0;
  }
  .citation figcaption {
    margin-bottom: 0.55rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-gray-600);
  }
  :global(.dark) .citation figcaption {
    color: var(--color-gray-400);
  }
  .citation blockquote {
    margin: 0;
    padding: 0.9rem 1.15rem;
    background-color: var(--color-gray-100);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    line-height: 1.75;
  }
  :global(.dark) .citation blockquote {
    background-color: var(--color-gray-800);
  }
</style>
