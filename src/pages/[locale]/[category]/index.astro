---
import Layout from "../../../layouts/Layout.astro";
import CatalogCard from "../../../components/CatalogCard.astro";
import FilterBar, { type Facet } from "../../../components/FilterBar.astro";
import * as m from "../../../paraglide/messages";
import { LOCALES, type Locale } from "../../../lib/i18n";
import {
  CATEGORIES,
  getResourcesByKinds,
  getToolsByKinds,
  type Category,
} from "../../../lib/catalog";
import {
  labelAccess,
  labelPeriod,
  labelTag,
  languageNames,
  resourceCard,
  searchText,
  toolCard,
  type CardProps,
} from "../../../lib/display";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    (Object.keys(CATEGORIES) as Category[]).map((category) => ({
      params: { locale, category },
    })),
  );
}

const locale = Astro.params.locale as Locale;
const category = Astro.params.category as Category;

const spec = CATEGORIES[category];

interface Row {
  card: CardProps;
  text: string;
  facets: Record<string, string[]>;
}

let rows: Row[];
if (spec.collection === "resources") {
  rows = (await getResourcesByKinds(spec.kinds)).map((r) => ({
    card: resourceCard(r, locale),
    text: searchText(r),
    facets: {
      lang: r.data.langs,
      period: r.data.period ?? [],
      tag: r.data.tags,
    },
  }));
} else {
  rows = (await getToolsByKinds(spec.kinds)).map((t) => ({
    card: toolCard(t, locale),
    text: searchText(t),
    facets: {
      lang: t.data.langs,
      access: [
        t.data.access.delivery,
        t.data.access.cost,
        ...(t.data.access.registration === "none"
          ? []
          : [t.data.access.registration]),
      ],
    },
  }));
}

const FACET_LABELS: Record<string, string> = {
  lang: m.languages({}, { locale }),
  period: m.period({}, { locale }),
  tag: m.tags({}, { locale }),
  access: m.access({}, { locale }),
};

const labelFor = (key: string, value: string): string => {
  if (key === "lang") return languageNames([value], locale)[0] ?? value;
  if (key === "period") return labelPeriod(value, locale);
  if (key === "tag") return labelTag(value, locale);
  return labelAccess(value, locale);
};

const facets: Facet[] = Object.keys(FACET_LABELS)
  .map((key) => {
    const values = [...new Set(rows.flatMap((row) => row.facets[key] ?? []))];
    return {
      key,
      label: FACET_LABELS[key],
      options: values
        .map((value) => ({ value, label: labelFor(key, value) }))
        .sort((a, b) => a.label.localeCompare(b.label, locale)),
    };
  })
  .filter((facet) => facet.options.length >= 2);

const titles: Record<Category, string> = {
  corpora: m.corpora({}, { locale }),
  datasets: m.datasets({}, { locale }),
  dictionaries: m.dictionaries({}, { locale }),
  archives: m.archives({}, { locale }),
  concordancers: m.concordancers({}, { locale }),
  tools: m.tools({}, { locale }),
};

const SUGGEST_URL = "https://github.com/oulcggc/corpus-hub/issues/new";
---

<Layout title={titles[category]} locale={locale}>
  <main
    class="mx-auto w-[800px] max-w-[calc(100%-2rem)] py-10 text-ink dark:text-white"
  >
    <h1 class="text-4xl font-bold mb-8">{titles[category]}</h1>
    {
      rows.length > 0 ? (
        <>
          <FilterBar locale={locale} facets={facets} />
          <div
            class="grid gap-4"
            style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));"
          >
            {rows.map(({ card, text, facets: rowFacets }) => (
              <div
                data-entry
                data-text={text}
                data-facet-lang={(rowFacets.lang ?? []).join(" ")}
                data-facet-period={(rowFacets.period ?? []).join(" ")}
                data-facet-tag={(rowFacets.tag ?? []).join(" ")}
                data-facet-access={(rowFacets.access ?? []).join(" ")}
              >
                <CatalogCard {...card} />
              </div>
            ))}
          </div>
        </>
      ) : (
        <p class="text-gray-600 dark:text-gray-400">
          <a class="underline" href={SUGGEST_URL}>
            {m.suggest({}, { locale })}
          </a>
        </p>
      )
    }
  </main>
</Layout>
