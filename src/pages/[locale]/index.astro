---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import CatalogCard from "../../components/CatalogCard.astro";
import * as m from "../../paraglide/messages";
import { LOCALES, localePath, type Locale } from "../../lib/i18n";
import { getToolsByKinds } from "../../lib/catalog";
import { toolCard } from "../../lib/display";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

const APP_NAME = "CorpusHub";
const [beforeWelcome, afterWelcome] = m
  .welcome({ name: "{name}" }, { locale })
  .split("{name}");

const concordancers = await getToolsByKinds(["concordancer"]);

const slugOf = (id: string) => id.replace(/^[a-z]{2}\//, "");
const allArticles = await getCollection("articles");
const bySlug = new Map<string, typeof allArticles>();
for (const article of allArticles) {
  const slug = slugOf(article.id);
  bySlug.set(slug, [...(bySlug.get(slug) ?? []), article]);
}
const articles = [...bySlug.values()]
  .map(
    (versions) =>
      versions.find((a) => a.data.locale === locale) ?? versions[0]!,
  )
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const languageBadge = (articleLocale: string) =>
  articleLocale === locale
    ? undefined
    : new Intl.DisplayNames([locale], { type: "language" }).of(articleLocale);

const categories = [
  {
    href: localePath(locale, "corpora"),
    title: m.corpora({}, { locale }),
    body: m.corporaDesc({}, { locale }),
  },
  {
    href: localePath(locale, "concordancers"),
    title: m.concordancers({}, { locale }),
    body: m.concordancersDesc({}, { locale }),
  },
  {
    href: localePath(locale, "dictionaries"),
    title: m.dictionaries({}, { locale }),
    body: m.dictionariesDesc({}, { locale }),
  },
  {
    href: localePath(locale, "datasets"),
    title: m.datasets({}, { locale }),
    body: m.datasetsDesc({}, { locale }),
  },
];
---

<Layout title={`${beforeWelcome}${APP_NAME}${afterWelcome}`} locale={locale} top>
  <main class="mx-auto w-[800px] max-w-[calc(100%-2rem)] py-12 text-xl leading-relaxed text-ink dark:text-white">
    <h1 class="mb-5 mt-2 text-center text-6xl font-bold leading-none text-balance">
      {beforeWelcome}<span class="text-gradient">{APP_NAME}</span>{afterWelcome}
    </h1>
    <p class="mb-12 mt-0 text-center text-2xl leading-snug">{m.slogan({}, { locale })}</p>

    {
      articles.length > 0 && (
        <section class="mb-12 rounded-xl bg-gradient-to-r from-accent-light/60 to-accent-light/30 px-8 py-10 shadow-soft dark:from-accent-dark/60 dark:to-accent-dark/30 dark:shadow-soft-dark">
          <h2 class="mb-8 mt-0 text-center text-3xl font-bold leading-tight">
            {m.featured({}, { locale })}
          </h2>
          <ul class="m-0 flex list-none flex-col gap-4 p-0">
            {articles.map((article) => (
              <li class="text-center leading-snug">
                <a
                  href={localePath(
                    article.data.locale,
                    `articles/${slugOf(article.id)}`,
                  )}
                  class="text-2xl font-bold text-gradient"
                >
                  {article.data.title}
                </a>
                {languageBadge(article.data.locale) && (
                  <span class="chip ml-2 align-middle">
                    {languageBadge(article.data.locale)}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section
      class="mb-12 grid gap-5"
      style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));"
    >
      {concordancers.map((tool) => <CatalogCard {...toolCard(tool, locale)} />)}
    </section>

    <p
      class="mb-12 mt-0 rounded-xl border border-accent-light/25 bg-gradient-to-r from-accent-light/60 to-accent-light/30 px-8 py-8 leading-relaxed shadow-soft dark:from-accent-dark/60 dark:to-accent-dark/30 dark:shadow-soft-dark [&_code]:rounded-md [&_code]:bg-accent-dark/10 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-sm [&_code]:font-bold [&_code]:text-accent-dark dark:[&_code]:bg-accent-light/10 dark:[&_code]:text-accent-light [&_strong]:text-accent-dark dark:[&_strong]:text-accent-light"
      set:html={m.description({}, { locale })}
    />

    <ul
      role="list"
      class="m-0 grid grid-cols-[repeat(auto-fit,minmax(24ch,1fr))] gap-4 p-0"
    >
      {
        categories.map(({ href, title, body }) => (
          <Card href={href} title={title} body={body} />
        ))
      }
    </ul>
  </main>
</Layout>
