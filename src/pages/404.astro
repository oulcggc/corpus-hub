---
import Layout from "../layouts/Layout.astro";
import * as m from "../paraglide/messages";
import { DEFAULT_LOCALE, localePath } from "../lib/i18n";
---

<Layout title={m.notFound({}, { locale: DEFAULT_LOCALE })} locale={DEFAULT_LOCALE}>
  <main class="mx-auto w-[800px] max-w-[calc(100%-2rem)] py-20 text-center text-ink dark:text-white">
    <h1 class="text-6xl font-bold mb-6">404</h1>
    <p class="text-2xl mb-10">{m.notFound({}, { locale: DEFAULT_LOCALE })}</p>
    <a class="underline text-xl" href={localePath(DEFAULT_LOCALE)}>CorpusHub</a>
  </main>
</Layout>
